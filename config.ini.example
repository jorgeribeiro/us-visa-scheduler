[USVISA]
; Account and current appointment info from https://ais.usvisa-info.com
USERNAME = example@example.com
PASSWORD = xxxxxxxxxx
; SCHEDULE_ID is in URL https://ais.usvisa-info.com/es-co/niv/schedule/SCHEDULE_ID/continue_actions
; SCHEDULE_ID is not IVR Account Number
SCHEDULE_ID = 99999999
; In case you required an appointment on ASC
NEED_ASC = True
; Spanish - Colombia
COUNTRY_CODE = es-co
; Bogotá
FACILITY_ID = 25
; Bogotá
ASC_ID = 26

[BLACKLISTED_DATES]
; Optional dates that should be skipped
DATE_RANGE_ONE = 2024-07-07,2024-07-17
DATE_RANGE_TWO = 2024-12-01,2024-12-31
DATE_RANGE_THREE = 2024-08-01

[ALLOWED_DATES]
; Optional dates to consider — if set, only dates within these ranges will be used for rescheduling
; (still subject to the "earlier than current appointment" and BLACKLISTED_DATES rules)
; DATE_RANGE_ONE = 2024-09-01,2024-09-30
; DATE_RANGE_TWO = 2024-10-15

[SCHEDULING]
; Minimum number of days between today and a candidate appointment date.
; Defaults to 1 if omitted (i.e. tomorrow is the earliest acceptable date; today is rejected).
MIN_DAYS_FROM_TODAY = 1

[ENVIRONMENT]
; Environment variables: LOCAL, AWS
USE = AWS
TIMEZONE = Asia/Dubai

[FREETRIAL]
; Enable free trial mode: auto reschedule is disabled
ENABLED = False

[PUSHOVER]
; Get push notifications via https://pushover.net/ (optional)
PUSH_TOKEN =
PUSH_USER =

[SENDGRID]
; Get email notifications via https://sendgrid.com/ (optional)
SENDGRID_API_KEY =
PRIMARY_EMAIL_RECIPIENT = primary@example.com

[GOOGLE_SHEETS]
; Add execution data to Google Sheets (optional)
SPREADSHEET_ID =